# =========================================
# Pronta Comanda - Backend
# Arquivo de exemplo de variáveis de ambiente
# =========================================
# Copie este arquivo para ".env" e preencha
# com os valores reais do seu ambiente:
#
#   cp .env.example .env
#
# O arquivo ".env" nunca deve ser commitado
# (já está no .gitignore).
# =========================================

# --- Banco de dados ---
# String de conexão do MongoDB.
# Local:  mongodb://localhost:27017/pronta-comanda
# Atlas:  mongodb+srv://usuario:senha@cluster.mongodb.net/pronta-comanda
MONGO_URI=mongodb://localhost:27017/pronta-comanda

# --- Autenticação (JWT) ---
# Chave secreta usada para assinar os tokens JWT.
# Gere uma chave forte com o comando:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_aleatoria_e_grande

# Tempo de expiração do token (ex: 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# --- Servidor ---
# Porta em que a API vai rodar
PORT=3333

# Ambiente de execução: development | production | test
NODE_ENV=development

# --- Integração com o frontend ---
# URL do frontend, usada por exemplo em configurações de CORS
FRONTEND_URL=http://localhost:5173
