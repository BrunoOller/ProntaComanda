# Variáveis do docker-compose. Copie este arquivo para ".env" (na mesma pasta
# do docker-compose.yml):   cp .env.example .env
# O ".env" nunca vai pro Git.

# OBRIGATÓRIO: chave que assina o login (JWT). Deixe vazio aqui e gere a sua.
# O jeito mais fácil: este comando já grava uma chave aleatória no seu .env
#   sed -i "s/^JWT_SECRET=.*/JWT_SECRET=$(openssl rand -hex 64)/" .env
JWT_SECRET=

# Opcionais (o valor padrão está entre parênteses)
# WEB_PORT=8080                              # porta do sistema no navegador
# MONGO_PORT=27017                           # porta do Mongo na sua máquina (mude se der conflito)
# JWT_EXPIRES_IN=8h                          # duração do login
# TZ_ESTABELECIMENTO=America/Sao_Paulo       # fuso usado no rollup e no dashboard
